---
layout: null
permalink: /galleri/feed.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:media="http://search.yahoo.com/mrss/">
<channel>
  <title>SkuggeAI Galleri</title>
  <link>{{ '/galleri/' | absolute_url }}</link>
  <atom:link href="{{ '/galleri/feed.xml' | absolute_url }}" rel="self" type="application/rss+xml"/>
  <description>Nattens AI- og cybersikkerhetsnyheter illustrert av Qwen Image 2.1, prompt skrevet av Gemma 4 26B. Kun lokale modeller.</description>
  <language>no</language>
  {% assign bilder = site.galleri | sort: "date" | reverse %}
  {% if bilder.size > 0 %}<lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>{% endif %}
  {% for b in bilder limit: 40 %}
  {% assign anker = b.date | date: '%Y-%m-%d' | append: '-' | append: b.tema %}
  <item>
    <title>{{ b.tema_navn | xml_escape }} {{ b.date | date: "%d.%m.%Y" }}: {{ b.title | xml_escape }}</title>
    <link>{{ '/galleri/' | absolute_url }}#{{ anker }}</link>
    <guid isPermaLink="false">skuggeai-galleri-{{ anker }}</guid>
    <pubDate>{{ b.date | date_to_rfc822 }}</pubDate>
    {% capture beskr %}<p><img src="{{ b.bilde | absolute_url }}" alt="{{ b.title | escape }}"></p><p><em>{{ b.stil | escape }}</em></p><p>{{ b.prompt | escape }}</p>{% endcapture %}
    <description>{{ beskr | xml_escape }}</description>
    <enclosure url="{{ b.bilde | absolute_url }}" length="{{ b.bytes }}" type="image/jpeg"/>
    <media:content url="{{ b.bilde | absolute_url }}" medium="image" type="image/jpeg"/>
  </item>
  {% endfor %}
</channel>
</rss>
